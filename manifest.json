{
  "manifest_version": 3,
  "name": "Escout",
  "version": "1.0.0",
  "description": "Fast Etsy competitor research: exact keyword matching, one-click copy of titles, tags, descriptions and featured images, plus an optional live shop-stats overlay.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.etsy.com/*"],
      "js": [
        "content/dom-utils.js",
        "content/matcher.js",
        "content/etsy-detector.js",
        "content/extractors.js",
        "content/clipboard.js",
        "content/shop-info.js",
        "content/toolbar-ui.js",
        "content/main.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://www.etsy.com/*", "https://openapi.etsy.com/*"],
  "permissions": ["clipboardWrite", "storage"]
}
